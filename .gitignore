*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)
*.pdf~

# R session/cache
.Rhistory
.RData
.Rproj.user/
Rplots.pdf

# HTML outputs from R/knitr
*.html

# OS
.DS_Store
